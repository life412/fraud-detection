# =============================
# Fraud Data Preprocessing Notebook
# =============================

# Import libraries
import os
import pandas as pd
import numpy as np

# Paths
RAW_DATA = "../data/raw/Fraud_Data.csv"
IP_DATA = "../data/raw/IpAddress_to_Country.csv"
PROCESSED_DATA = "../data/processed/fraud_processed.csv"

# Ensure processed folder exists
os.makedirs("../data/processed", exist_ok=True)

# Load datasets
fraud_df = pd.read_csv(RAW_DATA)
ip_df = pd.read_csv(IP_DATA)

print("Fraud data shape:", fraud_df.shape)
print("IP mapping shape:", ip_df.shape)

# -----------------------------
# Data Cleaning
# -----------------------------
fraud_df.drop_duplicates(inplace=True)

# Convert time columns
fraud_df["signup_time"] = pd.to_datetime(fraud_df["signup_time"])
fraud_df["purchase_time"] = pd.to_datetime(fraud_df["purchase_time"])

# Check for nulls
print(fraud_df.isnull().sum())

# -----------------------------
# Feature Engineering
# -----------------------------
# Time-based features
fraud_df["hour_of_day"] = fraud_df["purchase_time"].dt.hour
fraud_df["day_of_week"] = fraud_df["purchase_time"].dt.dayofweek
fraud_df["time_since_signup"] = (fraud_df["purchase_time"] - fraud_df["signup_time"]).dt.total_seconds()

# -----------------------------
# IP to Country Mapping
# -----------------------------
fraud_df["ip_address"] = fraud_df["ip_address"].astype(int)
ip_df["lower_bound_ip_address"] = ip_df["lower_bound_ip_address"].astype(int)
ip_df["upper_bound_ip_address"] = ip_df["upper_bound_ip_address"].astype(int)

def map_ip_to_country(ip):
    row = ip_df[(ip_df["lower_bound_ip_address"] <= ip) & (ip_df["upper_bound_ip_address"] >= ip)]
    return row["country"].values[0] if not row.empty else "Unknown"

fraud_df["country"] = fraud_df["ip_address"].apply(map_ip_to_country)

# -----------------------------
# Save processed data
# -----------------------------
fraud_df.to_csv(PROCESSED_DATA, index=False)
print("Processed fraud data saved to:", PROCESSED_DATA)

# -----------------------------
# Quick EDA
# -----------------------------
print("Class distribution:\n", fraud_df["class"].value_counts(normalize=True))
print("Head of processed data:\n", fraud_df.head())
